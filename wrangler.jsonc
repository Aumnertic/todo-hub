{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 只走自定义域名（受 Access 保护），关掉 workers.dev 和预览地址
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "todo.aumnertic.top", "custom_domain": true }],

  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-hub",
      "database_id": "af74eea6-f7b2-4a39-bfbd-5a1a48dd230f",
      "migrations_dir": "migrations"
    }
  ],

  // review / 提问 / 每日汇总邮件。目标地址必须是 Email Routing 里已验证的地址
  "send_email": [{ "name": "MAILER" }],

  "triggers": {
    "crons": [
      "*/5 * * * *", // 回收过期租约
      "0 1 * * *"    // 每日汇总（UTC 01:00 = 北京时间 09:00）
    ]
  },

  "vars": {
    "ACCESS_TEAM_DOMAIN": "cool-hill-a857.cloudflareaccess.com",
    "ACCESS_AUD": "a413b5684936c41842da8d7287ffb4313481f7fc732ca6e37069217fef00ca19", // Access 应用 todo-hub
    "PUBLIC_URL": "https://todo.aumnertic.top",
    "MAIL_FROM": "todo@aumnertic.top",
    "DEV_AUTH": "0"                // 只有 .dev.vars 里设为 1，允许 X-Dev-Actor 头
  }
}
